<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Rendered by scripts/install_mac.sh. Answers Telegram commands; see job_radar/bot.py. -->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>__LABEL__</string>
    <key>ProgramArguments</key>
    <array>
        <string>__PYTHON__</string>
        <string>-m</string>
        <string>job_radar</string>
        <string>bot</string>
    </array>
    <key>WorkingDirectory</key>
    <string>__REPO__</string>
    <!-- Always running (restarted if it exits). It does not keep the Mac awake. -->
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>ThrottleInterval</key>
    <integer>30</integer>
    <key>StandardOutPath</key>
    <string>__BOTLOG__</string>
    <key>StandardErrorPath</key>
    <string>__BOTLOG__</string>
    <key>EnvironmentVariables</key>
    <dict>
        <key>PYTHONUNBUFFERED</key>
        <string>1</string>
        <key>PYTHONIOENCODING</key>
        <string>utf-8</string>
        <key>JOB_RADAR_LOG_FILE</key>
        <string>__BOTLOG__</string>
        <key>PATH</key>
        <string>/usr/bin:/bin:/usr/sbin:/sbin</string>
    </dict>
</dict>
</plist>
