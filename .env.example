# Copy to .env and fill in. Never commit .env.
ANTHROPIC_API_KEY=
TELEGRAM_BOT_TOKEN=
# Get it with: python -m job_radar telegram-setup
TELEGRAM_CHAT_ID=

# --- Docker only (docker-compose.yml) ---
# Time zone for the schedule and notify_window (default America/Mexico_City). Docker only: leave it commented on
# macOS, where the Mac's own time zone is used.
# TZ=America/Bogota
# Portal port on this machine (default 4747):
# PORTAL_PORT=4747
# Optional remote access (docker compose --profile remote up -d):
NGROK_AUTHTOKEN=
NGROK_DOMAIN=
NGROK_ALLOWED_EMAILS=
